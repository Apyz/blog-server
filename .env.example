# ============================================================
#  My Blog - 环境变量示例
#  复制为 .env 后修改（本地运行会自动读取 .env 文件）
#  云平台（Uppcoder / Zeabur / Railway 等）请直接在控制台配置
# ============================================================

# HTTP 监听端口（留空默认 8080，监听 0.0.0.0:$PORT）
PORT=8080

# PostgreSQL 连接字符串
# 格式: postgres://用户名:密码@主机:端口/数据库名?sslmode=disable
# 云平台若提供的是 DATABASE_URL，直接复制即可；通常需要 sslmode=require
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/blog?sslmode=disable

# 后台管理员账号（默认 admin）
ADMIN_USERNAME=admin

# 后台管理员密码（默认 admin123，生产环境务必修改！）
ADMIN_PASSWORD=change-me-please

# JWT 签名密钥（留空则每次启动随机生成，重启后所有登录态失效）
# 生成方式: openssl rand -hex 32
JWT_SECRET=
